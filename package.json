{
  "name": "pi-obsidian-vault",
  "version": "0.2.3",
  "type": "module",
  "description": "Agent-safe Obsidian vault access for Pi: auto-detect, retrieve, validate, plan, write, edit, manage, and explicitly destroy Markdown with human approval.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itscool2b/pi-obsidian-vault.git"
  },
  "bugs": {
    "url": "https://github.com/itscool2b/pi-obsidian-vault/issues"
  },
  "homepage": "https://github.com/itscool2b/pi-obsidian-vault#readme",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "obsidian",
    "obsidian-vault",
    "vault",
    "markdown",
    "retrieval",
    "validation",
    "planning",
    "safe-writing",
    "safe-editing",
    "safe-note-management",
    "agent-safe",
    "safe-destruction",
    "human-approval",
    "auto-detect"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "skills": [
      "./skills/obsidian-research"
    ]
  },
  "files": [
    "src/",
    "skills/",
    "assets/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md",
    "RELEASE.md"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "prepublishOnly": "npm run check"
  },
  "dependencies": {},
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.79.5",
    "@earendil-works/pi-coding-agent": "^0.79.5",
    "@types/node": "^24.0.0",
    "typebox": "^1.1.24",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  }
}
