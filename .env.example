# pi-obsidian-vault retrieval harness configuration

# Absolute path to your local Obsidian vault folder.
# Used as the CLI working directory when OBSIDIAN_VAULT_NAME/ID is not set.
# You can also persist this in ~/.pi/agent/obsidian-vault.json:
# { "vaultPath": "/absolute/path/to/your/vault", "cliPath": "obsidian-cli" }
OBSIDIAN_VAULT_PATH=/absolute/path/to/your/vault

# Official Obsidian CLI binary. Auto-detects `obsidian-cli` when present, otherwise falls back to `obsidian`.
# If `obsidian` opens the desktop app, set this to `obsidian-cli`.
# OBSIDIAN_CLI_PATH=obsidian-cli

# Optional preferred vault targeting for the official Obsidian CLI.
# If set, the adapter passes vault=<value> before the command.
# OBSIDIAN_VAULT_NAME="My Vault"
# OBSIDIAN_VAULT_ID="vault-id"

# CLI command timeout in milliseconds.
# OBSIDIAN_CLI_TIMEOUT_MS=10000

# Retrieval budgets. All responses remain hard-capped even if these are raised.
# OBSIDIAN_RETRIEVE_TINY_CHARS=3500
# OBSIDIAN_RETRIEVE_STANDARD_CHARS=8000
# OBSIDIAN_RETRIEVE_EXPANDED_CHARS=12000

# Optional real-vault evaluation. Tests use the fake CLI by default.
# OBSIDIAN_EVAL_VAULT=false
