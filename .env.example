# pi-obsidian-vault configuration example
#
# Tool note paths are vault-relative. Only OBSIDIAN_VAULT_PATH identifies the
# local vault root and may be an absolute local path.

# Required for local obsidian_write, obsidian_edit, and obsidian_manage.
# Also used as the retrieval CLI working directory when OBSIDIAN_VAULT_NAME/ID is not set.
OBSIDIAN_VAULT_PATH=/absolute/path/to/your/vault

# Official Obsidian CLI binary. Prefer obsidian-cli if `obsidian` opens the desktop app.
OBSIDIAN_CLI_PATH=obsidian-cli

# Optional retrieval-only vault targeting for the official Obsidian CLI adapter.
# Vault name/id targets do not enable local mutations; local mutations still require OBSIDIAN_VAULT_PATH.
# OBSIDIAN_VAULT_NAME="My Vault"
# OBSIDIAN_VAULT_ID="vault-id"

# Canonical public release defaults.
OBSIDIAN_RETRIEVE_DEFAULT_BUDGET=standard
OBSIDIAN_RELATIONSHIP_DEFAULT_BUDGET=standard
OBSIDIAN_MAX_PREVIEW_CHARS=4000
OBSIDIAN_VALIDATE_MAX_ISSUES=50
OBSIDIAN_TRASH_FOLDER=_Trash
OBSIDIAN_COMMIT_TOKENS_REQUIRED=true
OBSIDIAN_COMMIT_TOKEN_TTL_SECONDS=300
OBSIDIAN_COMMIT_TOKEN_STRICT_MODE=false
OBSIDIAN_WRITE_DRY_RUN_VALIDATION_ENABLED=true
OBSIDIAN_APPEND_DRY_RUN_VALIDATION_ENABLED=true

# Advanced/legacy knobs. Keep bounded; config cannot enable unsafe powers.
# OBSIDIAN_CLI_TIMEOUT_MS=10000
# OBSIDIAN_RETRIEVE_TINY_CHARS=3500
# OBSIDIAN_RETRIEVE_STANDARD_CHARS=8000
# OBSIDIAN_RETRIEVE_EXPANDED_CHARS=12000

# Optional real-vault evaluation. Tests use fake CLI/temp vaults by default.
# Real-vault checks are manual/opt-in only; do not run committed smoke tests against a real vault by default.
# OBSIDIAN_EVAL_VAULT=false
# OBSIDIAN_EVAL_WRITE=false
# OBSIDIAN_EVAL_WRITE_CREATE_PATH="_pi_write_smoke/Dry Run Preview.md"
# OBSIDIAN_EVAL_WRITE_APPEND_PATH="Existing/Note.md"
