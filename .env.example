# pi-obsidian-vault
#
# Normal users do not need env vars. The extension auto-detects Obsidian
# Desktop vaults. If detection fails, tell the agent your vault folder path and
# it can remember it with obsidian_config or /obsidian-vault set-vault <path>.

# Optional hidden dev/test override only. Prefer obsidian_config for real use.
# OBSIDIAN_VAULT_PATH=/absolute/path/to/your/vault

# Optional real-vault evaluation. Tests use fake CLI/temp vaults by default.
# Real-vault checks are manual/opt-in only; do not run committed smoke tests against a real vault by default.
# OBSIDIAN_EVAL_VAULT=false
# OBSIDIAN_EVAL_WRITE=false
# OBSIDIAN_EVAL_WRITE_CREATE_PATH="_pi_write_smoke/Dry Run Preview.md"
# OBSIDIAN_EVAL_WRITE_APPEND_PATH="Existing/Note.md"
